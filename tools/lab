#!/bin/bash
# lab: start long jobs so they can't fail unseen, and show what is running.
#
#   lab start NAME 'COMMAND' [--progress 'CMD']   start in the background, in the
#                                                 current folder, then check it is running
#   lab status                                    every job in a sentence, and memory use
#   lab status NAME                               one job: working, finished or failed,
#                                                 its steps, what went wrong, what to do next
#   lab log NAME [LINES]                          the end of a job's log
#   lab stop NAME                                 stop a job and everything it started
#
# A job is WORKING, FINISHED, FAILED, STOPPED (by hand) or DIED (no longer
# running but never finished: killed, or the machine restarted).
# Jobs are kept in ~/lab-jobs/NAME/ (cmd, dir, pid, started, exit, log).
J="${LAB_JOBS:-$HOME/lab-jobs}"
CHECK="${LAB_CHECK:-15}"   # seconds to watch a new job before saying it started
PROBLEMS='^!!!|Traceback|Error|error:|Killed|No such file|command not found|too few|Nothing published'

die() { echo "lab: $*" >&2; exit 1; }
alive() { [ -f "$1/pid" ] && kill -0 "$(cat "$1/pid")" 2>/dev/null; }
state() {
  if [ -f "$1/exit" ]; then
    case "$(cat "$1/exit")" in 0) echo done ;; stopped) echo stopped ;; *) echo "FAILED ($(cat "$1/exit"))" ;; esac
  elif alive "$1"; then echo running
  else echo LOST
  fi
}
ended() { [ -f "$1/exit" ] && stat -f %m "$1/exit"; }
lastline() { grep -av '^[[:space:]]*$' "$1/log" 2>/dev/null | tail -n 1 | tr -d '\r' | cut -c1-70; }
problems() { grep -aEc "$PROBLEMS" "$1/log" 2>/dev/null; }
tree() {  # a pid and all its descendants
  local p; echo "$1"; for p in $(pgrep -P "$1"); do tree "$p"; done
}

start() {
  local name="$1" cmd="$2" prog=""
  [ -n "$name" ] && [ -n "$cmd" ] || die "usage: lab start NAME 'COMMAND' [--progress 'CMD']"
  [ "$3" = "--progress" ] && prog="$4"
  local d="$J/$name"
  if [ -d "$d" ] && alive "$d" && [ ! -f "$d/exit" ]; then die "$name is already running (lab status $name)"; fi
  rm -rf "$d"; mkdir -p "$d"
  printf %s "$cmd" > "$d/cmd"; pwd > "$d/dir"; date +%s > "$d/started"
  [ -n "$prog" ] && printf %s "$prog" > "$d/progress"
  nohup bash -c 'echo $$ > "$1/pid"; cd "$2" || exit 1; caffeinate -i bash -c "$3"; echo $? > "$1/exit"' \
    _ "$d" "$PWD" "$cmd" < /dev/null > "$d/log" 2>&1 &
  local i=0
  while [ $i -lt "$CHECK" ]; do
    sleep 1; i=$((i + 1))
    [ -f "$d/exit" ] && break
  done
  case "$(state "$d")" in
    running) echo "STARTED  $name is running (checked for ${CHECK}s).  lab status to see it." ;;
    done)    echo "FINISHED $name already finished, with no error."; tail -n 5 "$d/log" ;;
    *)       echo "NOT RUNNING  $name: $(state "$d") within ${i}s. The end of its log:"; tail -n 15 "$d/log"; exit 1 ;;
  esac
}

dur() {  # seconds -> "1 h 20 min" / "12 min"
  local m=$(( $1 / 60 )); [ $m -ge 60 ] && echo "$((m / 60)) h $((m % 60)) min" || echo "$m min"
}
took() { dur $(( ${2:-$(date +%s)} - $(cat "$1/started") )); }
at() { date -r "$1" "+%H:%M"; }
# The job's own plain-words step (first line of its progress command), if it has one
step() { [ -f "$1/progress" ] && (cd "$(cat "$1/dir")" && bash -c "$(cat "$1/progress")") 2>/dev/null | head -n 1; }
# One sentence: is it working, finished or failed, and since when
headline() {
  local d="$1" st e; st=$(state "$d"); e=$(ended "$d")
  case "$st" in
    running) echo "WORKING, for $(took "$d") so far." ;;
    done)    echo "FINISHED without errors at $(at "$e"), after $(took "$d" "$e")." ;;
    stopped) echo "STOPPED by hand at $(at "$e"), after $(took "$d" "$e")." ;;
    LOST)    echo "DIED: it is no longer running and never finished (killed, or the machine restarted)." ;;
    *)       echo "FAILED at $(at "$e"), after $(took "$d" "$e")." ;;
  esac
}

status_all() {
  local d n=0
  for d in "$J"/*/; do
    [ -f "$d/started" ] || continue
    d="${d%/}"; n=$((n + 1))
    local p st; p=$(problems "$d"); st=$(state "$d")
    echo "$(basename "$d"): $(headline "$d")"
    if [ "$st" = running ]; then
      local w; w=$(step "$d"); echo "    ${w:-Last line: $(lastline "$d")}"
      [ "${p:-0}" -gt 0 ] && echo "    Something went wrong along the way: lab status $(basename "$d")"
    elif [ "$st" != done ]; then
      echo "    What went wrong: $(grep -aE "$PROBLEMS" "$d/log" | tail -n 1 | cut -c1-90)"
    fi
  done
  [ $n = 0 ] && echo "No jobs."
  echo
  echo "Using memory:"
  ps -axo pid=,rss=,etime=,command= | awk '
    { c=$4; sub(".*/","",c) }
    c !~ /^(python[0-9.]*|mlx_lm.*|ollama.*)$/ { next }
    { prog=c; m=""
      if (c ~ /^python/) { prog=$5; if (prog=="-m" || prog=="-I") prog=$6; sub(".*/","",prog) }
      for (i=5;i<=NF;i++) if ($i=="--model") { m=$(i+1); sub(".*/","",m) }
      if (prog !~ /mlx_lm|ollama/ && $2 < 524288) next
      n++; printf "  %5.1f GB  %s%s\n", $2/1048576, prog, (m ? "  (" m ")" : "") }
    END { if (!n) print "  no model processes" }'
  echo "  $(memory_pressure 2>/dev/null | tail -n 1 | sed 's/.*: //') of memory free"
}

status_one() {
  local d="$J/$1"; [ -f "$d/started" ] || die "no job called $1"
  local st p; st=$(state "$d"); p=$(problems "$d")
  echo "$1 is $(headline "$d")"
  echo "  (started $(date -r "$(cat "$d/started")" "+%a %d %b at %H:%M"))"
  if [ -f "$d/progress" ]; then
    echo; (cd "$(cat "$d/dir")" && bash -c "$(cat "$d/progress")") 2>&1
  fi
  if [ "${p:-0}" -gt 0 ]; then
    echo; echo "What went wrong:"; grep -aE "$PROBLEMS" "$d/log" | tail -n 5 | cut -c1-200 | sed 's/^/  /'
  fi
  echo
  case "$st" in
    running) [ "${p:-0}" -gt 0 ] && echo "Next: it is still going, but paste this to Claude." \
               || echo "Next: nothing to do. Check back later." ;;
    done)    echo "Next: tell Claude it finished, and copy the results back." ;;
    stopped) echo "Next: nothing; it was stopped by hand." ;;
    *)       echo "Next: paste this to Claude."; echo; echo "Last lines of its log:"
             grep -av '^[[:space:]]*$' "$d/log" | tail -n 8 | cut -c1-200 | sed 's/^/  /' ;;
  esac
}

stop() {
  local d="$J/$1"; [ -f "$d/started" ] || die "no job called $1"
  alive "$d" && [ ! -f "$d/exit" ] || die "$1 is not running ($(state "$d"))"
  local pids; pids=$(tree "$(cat "$d/pid")")
  echo stopped > "$d/exit"
  kill $pids 2>/dev/null; sleep 2; kill -9 $pids 2>/dev/null
  echo "stopped $1"
}

case "$1" in
  start)  shift; start "$@" ;;
  status) [ -n "$2" ] && status_one "$2" || status_all ;;
  log)    [ -f "$J/$2/log" ] || die "no job called $2"; tail -n "${3:-40}" "$J/$2/log" ;;
  stop)   stop "$2" ;;
  *)      sed -n '2,14p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
